# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# App URL for auth redirects (http://localhost:3000 for dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of your self-hosted app. Alert emails and webhooks link here; required for alert delivery.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AES-256 key for encrypting tool API keys at rest (server-only). Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# Shared secret guarding the /api/poll balance-refresh endpoint (server-only)
POLL_SECRET=

# Ping URL of an external cron monitor / dead-man's switch, e.g. Healthchecks.io
# (server-only, optional). Every poll run pings it; a failed run pings
# <url>/fail. Leave unset and nothing is pinged. This is the only monitoring
# signal that survives your instance being down, because a run that never
# happens cannot report itself.
POLL_HEARTBEAT_URL=

# Where a failed poll run is emailed (server-only, optional). Needs
# POSTMARK_SERVER_TOKEN. Leave unset and no mail is sent - poll_runs still
# records every run either way.
POLL_ALERT_EMAIL=

# Postmark server API token for transactional + alert emails (server-only).
# Optional: without it the app still runs and just skips email alerts (in-app
# alerts keep working). See docs/SELF_HOSTING.md.
POSTMARK_SERVER_TOKEN=

# Where in-app feedback and bug reports are emailed (server-only, optional).
# Leave unset and no notification is sent: submissions are still stored in your
# own feedback_submissions table, and nothing leaves your instance.
FEEDBACK_NOTIFY_EMAIL=

# Marketing origin used for app→docs links. Prod is set on Railway;
# locally you can point at http://marketing.localhost:3000 if you run the
# marketing surface, otherwise the default sends you to the live docs.
NEXT_PUBLIC_MARKETING_URL=https://quotacanary.com

# Plausible analytics script URL (server-only, optional). Leave unset and no
# analytics script loads at all - that is the default for self-hosted
# instances. The hosted deployment sets this in Railway.
PLAUSIBLE_SCRIPT_SRC=

# Self-host single-domain mode. Set to "true" when you run QuotaCanary on one
# domain (no marketing/app host split) so every request serves the app. Leave
# unset for the two-surface hosted setup.
APP_ONLY=
