---
// Apple brand icon (Font Awesome Free 6.7.2, CC BY 4.0; see
// public/img/apple.LICENSE.txt). Rendered as an <img> like the design pass.
interface Props {
  width?: number
  height?: number
  class?: string
}
const { width = 13, height = 18, class: className } = Astro.props
---

<img
  class:list={["apple-icon", className]}
  src="/img/apple.svg"
  alt=""
  width={width}
  height={height}
/>
