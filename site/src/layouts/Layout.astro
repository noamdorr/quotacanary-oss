---
import "../styles/impeccable.css"
import "../styles/site.css"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { SITE_URL, TAGLINE } from "../lib/copy"

interface Props {
  title: string
  description: string
  /** Path for the canonical URL, e.g. "/directory/hunter". */
  path: string
  ogTitle?: string
  ogDescription?: string
  /** Raw JSON-LD, already serialized. */
  jsonLd?: string
}

const { title, description, path, ogTitle, ogDescription, jsonLd } = Astro.props
const canonical = `${SITE_URL}${path === "/" ? "/" : path}`
const ogImageAlt = `QuotaCanary - ${TAGLINE}`

// Analytics is opt-in and set only on the hosted deployment: a self-host or
// a CI build leaves PLAUSIBLE_SCRIPT_SRC unset and ships no third-party
// script. Baked in at build time; server.mjs reads the same variable to put
// the script's origin into the Content-Security-Policy.
const plausibleSrc = import.meta.env.PROD ? import.meta.env.PLAUSIBLE_SCRIPT_SRC : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="QuotaCanary" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}/og.jpg`} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={`${SITE_URL}/og.jpg`} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    {
      plausibleSrc && (
        <>
          <script is:inline defer data-domain="quotacanary.com" src={plausibleSrc} />
          <script is:inline defer src="/plausible-init.js" />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
