---
import Layout from "../../layouts/Layout.astro"
import { DIRECTORY, TOOL_REQUEST_MAILTO, TOOL_SUBMIT_URL } from "../../lib/copy"
import { BUCKET_ORDER, TOOLS, bucketLabel, bucketOf } from "../../lib/tools"

// Copy carried over from the Next ToolsDirectory component (live on master).
// One section per bucket, in chip order; TOOLS is already sorted by name inside each.
const groups = BUCKET_ORDER.map((bucket) => ({
  bucket,
  tools: TOOLS.filter((tool) => bucketOf(tool) === bucket),
})).filter((group) => group.tools.length > 0)
---

<Layout
  title="API tools your Mac can watch - QuotaCanary"
  description="Find the API tools QuotaCanary watches from your Mac menu bar. See the balances each tool exposes and which key it needs. Your keys stay on your Mac."
  path="/directory"
>
  <section class="page page-wide wrap directory" aria-labelledby="directory-title">
    <div class="directory-head">
      <p class="eyebrow">Tool directory</p>
      <h1 id="directory-title">Every tool QuotaCanary watches.</h1>
      <p class="page-lead">
        Pick a tool to see what it bills on and which key it needs.
        Not here? <a href={TOOL_REQUEST_MAILTO}>Ask for it</a>.
      </p>
      <p class="tools-foot directory-submit">
        {DIRECTORY.submitLead} <a href={TOOL_SUBMIT_URL} target="_blank" rel="noopener">{DIRECTORY.submitLink}</a>.
      </p>
    </div>

    <form class="directory-controls" role="search" data-directory-controls>
      <input
        type="search"
        class="directory-search"
        name="q"
        placeholder="Search tools..."
        aria-label="Search tools"
        autocomplete="off"
      />
      <button type="button" class="chip" data-category="all" aria-pressed="true">All</button>
      {
        groups.map(({ bucket }) => (
          <button type="button" class="chip" data-category={bucket} aria-pressed="false">
            {bucketLabel(bucket)}
          </button>
        ))
      }
    </form>

    <p class="directory-count" aria-live="polite" data-directory-count>
      {TOOLS.length} tools
    </p>

    <div data-directory-list>
      {
        groups.map(({ bucket, tools }) => (
          <section class="directory-group" data-group={bucket} aria-labelledby={`group-${bucket}`}>
            <h2 class="directory-group-title" id={`group-${bucket}`}>
              {bucketLabel(bucket)}
            </h2>
            <div class="tool-directory">
              {tools.map((tool) => (
                <a href={`/directory/${tool.id}`} data-name={tool.name.toLowerCase()} data-category={bucket}>
                  <img src={tool.logo_url} alt="" width="32" height="32" loading="lazy" decoding="async" />
                  <span>{tool.name}</span>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
    <p class="directory-empty" data-directory-empty hidden>
      We don’t watch that one yet. <a href={TOOL_REQUEST_MAILTO}>Ask for it</a> and we’ll see if it
      has a balance endpoint.
    </p>
  </section>
</Layout>

<script>
  // Client-side filter over the prerendered list: same behaviour as the Next
  // ToolsDirectory (name substring + one bucket chip). A bucket section hides
  // when none of its tiles match.
  const controls = document.querySelector<HTMLFormElement>("[data-directory-controls]")
  const list = document.querySelector<HTMLElement>("[data-directory-list]")
  const count = document.querySelector<HTMLElement>("[data-directory-count]")
  const empty = document.querySelector<HTMLElement>("[data-directory-empty]")
  if (controls && list && count && empty) {
    const input = controls.querySelector<HTMLInputElement>("input[type=search]")!
    const chips = Array.from(controls.querySelectorAll<HTMLButtonElement>("[data-category]"))
    const items = Array.from(list.querySelectorAll<HTMLAnchorElement>("a[data-name]"))
    const groups = Array.from(list.querySelectorAll<HTMLElement>("[data-group]"))
    let category = "all"

    const apply = () => {
      const q = input.value.trim().toLowerCase()
      let shown = 0
      for (const item of items) {
        const match =
          (category === "all" || item.dataset.category === category) &&
          (q === "" || (item.dataset.name ?? "").includes(q))
        item.hidden = !match
        if (match) shown++
      }
      for (const group of groups) {
        group.hidden = !group.querySelector("a[data-name]:not([hidden])")
      }
      count.textContent = `${shown} ${shown === 1 ? "tool" : "tools"}`
      empty.hidden = shown !== 0
    }

    controls.addEventListener("submit", (event) => event.preventDefault())
    input.addEventListener("input", apply)
    for (const chip of chips) {
      chip.addEventListener("click", () => {
        category = chip.dataset.category ?? "all"
        for (const other of chips) other.setAttribute("aria-pressed", String(other === chip))
        apply()
      })
    }
  }
</script>
